# Copy to keystore.properties and fill in. That file is git-ignored.
#
# Create the keystore first (once, and never again — the same key must sign
# every update for the life of the app):
#
#   keytool -genkey -v -keystore plank-plan-upload.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then back up the .jks and these passwords somewhere that is not this machine.
# Google can reset an upload key if you lose it, but only if you set up Play
# App Signing; the Apple equivalent has no such escape hatch.
storeFile=../plank-plan-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
